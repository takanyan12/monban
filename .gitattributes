# どの PC で取得しても改行を変えない（既定は LF 固定。Windows の自動変換で照合が合わなくなるのを防ぐ）
* text=auto eol=lf

# Raspberry Pi で動かすものは LF 固定（CRLF だと bash / python が壊れる）
*.sh      text eol=lf
*.py      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.tmpl    text eol=lf
*.md      text eol=lf
*.php     text eol=lf

# Windows 用バッチは CP932 + CRLF のまま一切変換しない（文字コードを変えると netsh の照合が壊れる）
*.bat     -text
SHA256SUMS.txt text eol=lf
*.json    text eol=lf
